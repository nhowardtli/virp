[Unit]
Description=VIRP TACACS+ authentication/authorization server (tac_plus-ng)
Documentation=file:///opt/virp/docs/TACACS-ACCOUNTING.md
Documentation=file:///etc/tacacs/README.md
After=network-online.target
Wants=network-online.target

# Deliberately NOT related to the accounting receiver in any way. This
# unit must never be ordered against, or share a failure with,
# virp-tacacs.service on 313. docs/TACACS-ACCOUNTING.md 9.4: accounting
# surviving an authorization outage is the property that makes a
# break-glass visible, and it only holds while these are independent.

[Service]
# Type=exec, NOT forking, and deliberately no PIDFile. spawnd reloads by
# execve()ing itself, which preserves the pid only while it stays in the
# foreground (`background = no` in tac_plus-ng.cfg). Tracking it by
# pidfile instead made the service die silently on the second reload --
# see the comment in tac_plus-ng.cfg.
Type=exec
RuntimeDirectory=tacacs
RuntimeDirectoryMode=0755

# FAIL CLOSED ON BAD CONFIG.
#
# The check runs BEFORE every start and every restart. If the config
# does not parse, ExecStartPre fails, systemd never runs ExecStart, and
# the service stays down. A TACACS+ server that is down denies every
# per-command authorization on every device pointed at it -- which is
# the correct outcome for a policy nobody can parse. The alternative,
# starting with a partially-understood policy, is how a deny-list turns
# into an allow-list.
ExecStartPre=/usr/local/sbin/tac_plus-ng -P /etc/tacacs/tac_plus-ng.cfg

ExecStart=/usr/local/sbin/tac_plus-ng -f /etc/tacacs/tac_plus-ng.cfg

# Reload goes through the wrapper, which repeats the check and REFUSES to
# signal if it fails. Raw SIGHUP is not checked by the daemon: spawnd
# execve()s on SIGHUP and would die on a bad config. See tacacs-reload.
ExecReload=/usr/local/sbin/tacacs-reload $MAINPID

# Restart=always, not on-failure. A config error is caught by
# ExecStartPre and never reaches here; what Restart must cover is the
# daemon going away for any reason at all, including an exit that looks
# clean. An authorization server that is down denies every command on
# every device pointed at it, so "it exited tidily" is not a reason to
# leave it down.
Restart=always
RestartSec=5s

# The daemon binds port 49 and reads 0600 root-owned secrets, so it
# starts as root. Everything else is taken away.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelModules=yes
RestrictNamespaces=yes
# ProtectKernelTunables and ProtectControlGroups are deliberately ABSENT.
# Both need to remount /proc/sys and /sys/fs/cgroup read-only, which an
# unprivileged LXC container cannot do -- systemd fails the unit with
# 226/NAMESPACE before ExecStartPre ever runs. Little is lost: in an
# unprivileged container those trees are already not writable by this
# process. Re-add both if this server is ever moved to a VM or to bare
# metal, where they cost nothing and do work.
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# The only paths it may write. /etc/tacacs stays read-only to the
# daemon: the policy writer is a separate actor and the daemon has no
# business editing the policy it enforces.
ReadWritePaths=/var/log/tacacs /run/tacacs
ReadOnlyPaths=/etc/tacacs

[Install]
WantedBy=multi-user.target
