# deploy/tacacs/secrets.conf.example
#
# STRUCTURE ONLY. The real file lives at /etc/tacacs/secrets.conf on the
# server, 0600 root:root, generated on the box by install-authz-server.sh
# and never committed, never printed, never echoed into a transcript.
#
# Every ${...} below is a placeholder. install-authz-server.sh fills them
# with `openssl rand` output. If you are reading a file that still
# contains a ${...}, it is the example, not a live config.
#
# Included LAST by tac_plus-ng.cfg, because `user` blocks reference
# profiles that must already be defined.

# ----------------------------------------------------------------------
# Device shared keys.
#
# One `host` block per address range that may talk to this server. The
# key is the TACACS+ shared secret and is what the router's
# `tacacs server VIRP / key <...>` line must match.
#
# The GNS3 home fabric R1-R35 is 10.0.0.50-10.0.0.84. It is given ONE
# key because the lab already shares one credential across all 35
# routers (deploy/devices.home.template.json records that as a property
# of the lab, not something fixed here) -- a second key here would imply
# an isolation that does not exist.
# ----------------------------------------------------------------------
host gns3_home_fabric {
	address = 10.0.0.50/32
	address = 10.0.0.51/32
	# ... through 10.0.0.84 ; install-authz-server.sh emits the full list
	key = ${TACACS_KEY_GNS3_HOME}
}

# The container itself and the gate host, for Phase 3 proof traffic.
host virp_test_clients {
	address = 127.0.0.1/32
	address = 10.0.0.215/32
	address = 10.0.0.13/32
	address = 10.0.0.35/32
	key = ${TACACS_KEY_TEST}
}

# ----------------------------------------------------------------------
# LAB-SWITCH-1 -- Cisco 2960, IOS 12.2, at 10.0.0.10. AUTHN/AUTHZ ONLY.
#
# This key is NOT the 2960's accounting key. Accounting for this switch
# is a separate relationship with a separate secret on 313
# (10.0.0.13:4949, /etc/virp/tacacs/recv.json) and nothing here touches
# it. Two keys for one switch is deliberate: an authz key rotation must
# not be able to take accounting down with it.
#
# 12.2 has no named `tacacs server` block -- the key rides on the global
# line, `tacacs-server host 10.0.0.215 port 49 key <this>`. If the switch
# sets `ip tacacs source-interface`, the server sees the SOURCING address
# and it must be the one below or the request is refused.
# ----------------------------------------------------------------------
host LAB-SWITCH-1 {
	address = 10.0.0.10/32
	key = ${TACACS_KEY_LAB_SWITCH_1}
}

# ----------------------------------------------------------------------
# The two gate identities, per docs/TACACS-ACCOUNTING.md 9.1. These are
# the FENCED identities: per-command authorization, fail closed.
# ----------------------------------------------------------------------
user virp-ro {
	password login = clear ${VIRP_RO_PASSWORD}
	# PAP is a separate credential slot; without this, PAP auth FAILs
	# even with the right login password. `= login` defers to it.
	password pap = login
	profile = virp_ro_profile
}

user virp-rw {
	password login = clear ${VIRP_RW_PASSWORD}
	password pap = login
	profile = virp_rw_profile
}

# ----------------------------------------------------------------------
# Human operator accounts -- NOT fenced. See 9.1.
#
# `crypt` takes a crypt(3) setting string; tac_plus-ng calls crypt(3)
# directly (tac_plus-ng/authen.c:416) against libxcrypt, so the SHA-512
# `$6$` format that `openssl passwd -6` emits is accepted as-is. Verified
# end to end on CT 215, 2026-09-06: correct password PASS, wrong password
# FAIL.
#
# DO NOT write `password login = 6 ...`. The bare token `6` is a
# DIFFERENT thing -- Cisco type-6 reversible AES (tac_plus-ng/type6.c) --
# and the parser accepts it happily, so the mistake is silent. The
# keyword for a hash is `crypt`.
#
# The hash needs no quoting: `$`, `.` and `/` all lex fine inside the
# bare token (checked with -P both ways).
#
# `password pap = login` is kept for consistency with the gate accounts;
# an IOS VTY login is ASCII, so PAP is not on the path a human uses.
#
# The PLAINTEXT never appears anywhere. Generate the hash on the box:
#     openssl passwd -6
# and paste only its output over ${NHOWARD_HASH}.
# ----------------------------------------------------------------------
user nhoward {
	password login = crypt ${NHOWARD_HASH}
	password pap = login
	profile = operator_profile
}
