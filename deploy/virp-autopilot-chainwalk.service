[Unit]
Description=VIRP Autopilot — daily full chain verification walk + signed summary
After=virp-onode.service
Requires=virp-onode.service

[Service]
Type=oneshot
# NOT root, and NOT the daemon's uid (2026-11-04, feat/autopilot-nondaemon-uid):
# the owner policy refuses to load when the daemon's own uid is a
# principal, so a client sharing uid 999 is refused BLACK-13 on every
# execute. Runs as `virp-autopilot` (uid 971), a nologin account in no
# group but its own, which verifies v3 execute observations with the
# daemon's PUBLIC chain-signing key and holds no secret. Full reasoning
# and the ACL grant path: deploy/virp-autopilot.service and
# deploy/autopilot-access.sh.
User=virp-autopilot
Group=virp-autopilot
ExecStart=/usr/bin/python3 /usr/local/lib/virp/autopilot/virp_autopilot.py chainwalk
NoNewPrivileges=yes
PrivateTmp=yes
