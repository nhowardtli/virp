[Unit]
Description=VIRP Observation Node Daemon
After=network.target
# The devices.json writer (api/server.py /api/devices/add) must share
# group ownership of /var/lib/virp so the HTTP service can write what
# this daemon reads. Provision both units under the same `virp` user.

[Service]
Type=simple
# Runs as a dedicated service user, NOT root. Create with:
#   useradd --system --home-dir /var/lib/virp --shell /usr/sbin/nologin virp
# and give it ownership of /etc/virp/keys/onode.key (0600) and
# /var/lib/virp (0750). Never put credentials in devices.json —
# credential store is /etc/virp/creds.d/ (0700, root-owned).
User=virp
Group=virp

# Read-only key material plus mutable device list. Keep mutating
# state under StateDirectory so systemd creates+chowns it for us.
StateDirectory=virp
StateDirectoryMode=0750
# ---------------------------------------------------------------------
# EVERY PATH THIS UNIT EXECUTES IS AN INSTALLED ARTIFACT UNDER
# /usr/local/lib/virp — NEVER A FILE IN A SOURCE WORKTREE.
#
# This unit previously ran /opt/virp/build/virp-onode-prod and
# /opt/virp/deploy/*.sh, i.e. files inside a live git checkout. That made
# DEPLOYMENT AN ACCIDENT WAITING FOR A RESTART: any `make` in /opt/virp
# rewrote the binary in place, any edit to a deploy script changed daemon
# behaviour, and with Restart=always the next crash, reboot or
# `systemctl restart` silently shipped whatever happened to be there. The
# worktree had in fact already drifted 12 commits ahead of the running
# binary before anyone noticed.
#
# Deploying is now a deliberate act — `make install-prod`, which refuses
# on a dirty tree — and a restart ships exactly what was last installed.
# `make check-deploy-unit` fails if any Exec* line points back into a
# source tree, so this cannot regress quietly.
# ---------------------------------------------------------------------

# Device config is RENDERED at start: credentials live only in
# /etc/virp/autopilot.env (0600 root) and are substituted into the
# no-secrets template /etc/virp/devices.template.json, landing on the
# /run tmpfs as 0640 root:virp. The `+` prefix runs the render as root
# outside the sandbox; the daemon itself only reads the result. The
# render script never echoes credential values.
ExecStartPre=+/usr/local/lib/virp/render-devices.sh

# Wazuh TLS: the driver validates the Wazuh manager's certificate by
# default (VERIFYPEER=1, VERIFYHOST=2 in driver_wazuh.c). To point at a
# real Wazuh, set VIRP_CA_BUNDLE to the CA that signed its cert. The lab
# manager (10.0.20.10) presents a self-signed cert; disabling validation
# for it is a DELIBERATE, MANUAL act — install the drop-in
# deploy/virp-onode-wazuh-lab.dropin.conf, which is never wired into the
# default install path. `make check-deploy-unit` fails if
# VIRP_WAZUH_INSECURE ever reappears in this canonical unit.

# Chain flags (-c/-C) are REQUIRED here: approval mode (enabled whenever
# /etc/virp/approvers.json enrolls a key) refuses to start without a
# working trust chain — without it no PROPOSAL/APPROVAL/OUTCOME history
# is written. Provision the chain key before first start:
#   head -c 32 /dev/urandom > /etc/virp/keys/chain.key
#   chown virp:virp /etc/virp/keys/chain.key && chmod 0600 /etc/virp/keys/chain.key
# `make check-deploy-unit` fails if these flags are removed.
ExecStart=/usr/local/lib/virp/virp-onode-prod \
    -k /etc/virp/keys/onode.key \
    -s /run/virp/onode.sock \
    -d /run/virp/devices.json \
    -c /var/lib/virp/chain.db \
    -C /etc/virp/keys/chain.key

# Socket directory (RuntimeDirectory is auto-created 0755 virp:virp).
RuntimeDirectory=virp
RuntimeDirectoryMode=0750

Restart=always
RestartSec=5

# Sandbox
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Only /etc/virp/keys (read) and /var/lib/virp (write) are needed for
# device config; ProtectSystem=strict hides everything else.
ReadOnlyPaths=/etc/virp
ReadWritePaths=/var/lib/virp

[Install]
WantedBy=multi-user.target
