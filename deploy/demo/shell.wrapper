#!/usr/bin/python3
"""Forced demo command: bind the SSH-authenticated public key to its issued seat."""
import os,re,sys
from pathlib import Path
args=[]
auth=os.environ.get('SSH_USER_AUTH')
if auth:
    st=Path(auth).stat()
    if st.st_uid!=os.getuid() or st.st_mode & 0o077:raise SystemExit('Unsafe SSH authentication context')
    for line in Path(auth).read_text().splitlines():
        parts=line.split()
        if len(parts)>=3 and parts[0]=='publickey':
            key=parts[1]+' '+parts[2]
            for registered in Path('/etc/ssh/authorized_keys.d/virp-demo').read_text().splitlines():
                m=re.search(r' (ssh-ed25519|ecdsa-sha2-nistp(?:256|384|521)) ([A-Za-z0-9+/=]+) demo:([a-f0-9]{96})$',registered)
                if m and m[1]+' '+m[2]==key:args=['--demo-seat',m[3]];break
os.execv('/usr/bin/sudo',['sudo','-n','-u','virp-shell','--','/usr/bin/python3','/usr/local/lib/virp/virp-shell',*args,*sys.argv[1:]])
