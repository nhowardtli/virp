[Unit]
Description=VIRP Autopilot — cross-node comparator (diffs this node's view against the peer's)
After=virp-onode.service
Requires=virp-onode.service

[Service]
Type=oneshot
# NOT root: the daemon's socket_allowed_uids deliberately excludes uid 0
# (see DEPLOYED.md, "socket allowlist policy"). Runs as `virp`, the
# daemon's own service account: nologin, no sudo, and no read access to
# /etc/virp/autopilot.env, so it holds no device credentials.
#
# Why not a separate, even-less-privileged uid? Verifying an observation
# requires the O-Key — VIRP signs with symmetric HMAC — and
# virp_key_load_file refuses a key with group read ("insecure mode
# 0640"). A second account could therefore only verify by weakening key
# hygiene or by keeping a duplicate of the signing key on disk. Running
# as the key's owner avoids both. Verifier and signer become separable
# only when the daemon exposes a verify action.
User=virp
Group=virp
ExecStart=/usr/bin/python3 /opt/virp/autopilot/virp_autopilot.py comparator
NoNewPrivileges=yes
PrivateTmp=yes
