#!/usr/sbin/nft -f
# virp-sean egress lockdown — compensating control for the OpenSSH
# 9.6 quirk where AllowTcpForwarding=no also blocks streamlocal (Unix
# socket) forwards: the Match block for virp-sean therefore carries
# AllowTcpForwarding yes, and THIS rule is what denies TCP forwards.
# Rejects NEW IPv4/IPv6 connections originated by uid 987; the
# established inbound ssh session (also uid-owned after privilege
# drop) keeps flowing via the ct state exemption, and AF_UNIX is
# untouched by netfilter — the O-Node socket path stays open.
#
# This matters more for uid 987 than for 993. The far end of the 993
# tunnel is netclaw, an estate host. The far end of THIS tunnel is a VM
# operated by someone outside the estate, with a human holding root on
# it. Without this table, `ssh -L` from that VM would turn the seat into
# a general-purpose jump host into VLAN 10 — reaching every device on
# the management segment, none of which the gate is involved in. The
# action allowlist would still deny `execute` at the O-Node, and would
# be entirely beside the point.
#
# Uses its own table name so it can be loaded, listed and deleted
# independently of virp_netclaw_egress; two tables that both filter
# output do not interfere.
table inet virp_sean_egress {
    chain output {
        type filter hook output priority 0; policy accept;
        skuid 987 ct state established,related accept
        skuid 987 counter reject
    }
}
