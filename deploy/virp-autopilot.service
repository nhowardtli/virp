[Unit]
Description=VIRP Autopilot — 5-minute GREEN monitoring battery
After=virp-onode.service
Requires=virp-onode.service

[Service]
Type=oneshot
# NOT root: the daemon's socket_allowed_uids deliberately excludes uid 0
# (see DEPLOYED.md, "socket allowlist policy"). NOT the daemon's own uid
# either (2026-11-04, feat/autopilot-nondaemon-uid): the owner policy
# refuses to load when the daemon's uid is a principal, so a client that
# shares uid 999 is refused BLACK-13 on every execute. The autopilot now
# runs as `virp-autopilot` (uid 971), a nologin account that is a member
# of no group but its own: no sudo, no read of /etc/virp/autopilot.env,
# no read of onode.key or chain.key. It verifies execute observations
# with the daemon's PUBLIC chain-signing key (/etc/virp/keys/chain-sign.pub,
# v3 Ed25519 frames) and holds no secret at all. HMAC-only control frames
# (sign_outcome, chain_verify_session) are transport-attested by socket
# peer credential and labelled as such; the daemon's GATE 3 re-verifies
# anything appended. Socket/dir reach is granted by ACL from the daemon's
# ExecStartPost (deploy/autopilot-access.sh, 54-autopilot.conf), never
# by group membership.
User=virp-autopilot
Group=virp-autopilot
# Needs chain-sign.pub (verify), chain.db (read-only, immutable open),
# the onode socket, and the alert sink in /var/lib/virp/autopilot. Holds
# NO device credentials and NO signing or verifying secret.
ExecStart=/usr/bin/python3 /usr/local/lib/virp/autopilot/virp_autopilot.py cycle
NoNewPrivileges=yes
PrivateTmp=yes
