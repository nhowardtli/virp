#!/bin/sh
# /usr/local/bin/virp-shell — run the operator REPL as a VIRP seat.
#
# The shell is a plain socket client; the O-Node judges it by SO_PEERCRED,
# so the SEAT IS THE UID. This wrapper only changes identity, never
# privilege, and never runs anything as root:
#
#   own login   <your uid>        your row's ceiling  no sudo at all — the OPEN seat
#   read seat   virp-shell        uid 988  GREEN      sudo NOPASSWD
#   admin seat  virp-shell-admin  uid 985  YELLOW     sudo PASSWD (your password)
#   RED seat    virp-shell-red    uid 984  RED        sudo PASSWD (asked again)
#
# OPEN SEAT (2026-09-15): if the invoking uid has its own row in the rendered
# policy (/run/virp/devices.policy.json socket_uid_tier_ceilings), the shell runs AS
# THAT UID — no sudo, no enable — and everything typed is judged under that
# row's ceiling and chained under that identity. A row of "black" is the
# passthrough super-admin (reload, write erase … apply, on the record). This
# is ISE/TACACS accounting with a hash chain behind it: for a named human
# with a row, nothing asks permission and everything is attributable.
# Group virp can read only the credential-free policy projection.
#
# Shared seats: `enable` exits 42 → virp-shell-admin (sudo -k, asks every
# time); `enable red` exits 44 → virp-shell-red (asked again); `disable`
# exits 43 → back to the read seat. A wrong password lands you at the read
# seat. Rules: deploy/sudoers-virp-shell.
# Installed by `make install-virp-shell` from deploy/virp-shell.wrapper.

SHELL_PY=/usr/local/lib/virp/virp-shell
POLICY=/run/virp/devices.policy.json

me=$(id -u)
if [ "$me" -ne 0 ] && [ -r "$POLICY" ] && \
   python3 - "$POLICY" "$me" <<'PY' 2>/dev/null
import json, sys
d = json.load(open(sys.argv[1]))
c = {str(k): v for k, v in (d.get("socket_uid_tier_ceilings") or {}).items()}
a = [str(x) for x in d.get("socket_allowed_uids", [])]
sys.exit(0 if (sys.argv[2] in c and sys.argv[2] in a) else 1)
PY
then
    exec /usr/bin/python3 "$SHELL_PY" --own "$@"
fi

seat=virp-shell
while :; do
    case "$seat" in
        virp-shell-admin)
            sudo -k -p 'Password: ' -u virp-shell-admin -- /usr/bin/python3 "$SHELL_PY" --privileged "$@" ;;
        virp-shell-red)
            sudo -k -p 'Password (RED seat): ' -u virp-shell-red -- /usr/bin/python3 "$SHELL_PY" --privileged --red "$@" ;;
        *)
            sudo -u virp-shell -- /usr/bin/python3 "$SHELL_PY" "$@" ;;
    esac
    rc=$?
    case "$rc" in
        42) seat=virp-shell-admin ;;
        44) seat=virp-shell-red ;;
        43) seat=virp-shell ;;
        *)  if [ "$seat" != virp-shell ] && [ "$rc" -ne 0 ]; then
                # sudo refused (bad password, no rule): stay usable at the read seat.
                echo "% enable failed (sudo exit $rc); back at the read seat" >&2
                seat=virp-shell
            else
                exit "$rc"
            fi ;;
    esac
done
