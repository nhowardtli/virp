[Unit]
Description=VIRP Demo Bridge — TCP:9998 JSON API to O-Node
After=virp-onode.service
Requires=virp-onode.service

[Service]
Type=simple
User=virp-onode
Group=virp-clients

# /root/ is 0700, so virp-onode cannot traverse it. Stage the bridge
# script + its sibling module under /opt/virp/ during ExecStartPre
# (escalated via '+') before drop-privs.
ExecStartPre=+/bin/install -d -o virp-onode -g virp-clients -m 0750 /opt/virp
ExecStartPre=+/bin/install -o virp-onode -g virp-clients -m 0640 /root/virp/virp-bridge.py /opt/virp/virp-bridge.py
ExecStartPre=+/bin/install -o virp-onode -g virp-clients -m 0640 /root/virp/device_registry.py /opt/virp/device_registry.py

ExecStart=/usr/bin/python3 /opt/virp/virp-bridge.py

Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

# Enable Python HMAC fallback. The C bridge (api/virp_bridge.py +
# build/libvirp.so) is unreachable under /root/ traversal and its
# verify_observation() is functionally identical to Python HMAC-SHA256.
Environment=VIRP_ALLOW_PY_FALLBACK=1

# Hardening (W3 audit 2026-05-16) — bridge needs no capabilities;
# binds TCP:9998 (>1024) and connects to a Unix socket as virp-onode.
AmbientCapabilities=
CapabilityBoundingSet=
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
